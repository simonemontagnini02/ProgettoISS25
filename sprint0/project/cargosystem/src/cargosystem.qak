System cargosystem

Request load_request : load(PID)       // richiesta di carico di un container
Reply   load_accepted : slot(SlotID) for load_request
Reply   load_refused  : reason(Motivation) for load_request

Context ctxcargoserviceclients ip [ host="localhost" port=8111]

Context ctxcargoservice ip [ host="localhost" port=8110]

Context ctxproductservice ip [ host="localhost" port=8113]

Context ctxbasicrobot ip [ host="localhost" port=8114]

Context ctxiodevices ip [ host="localhost" port=8112]

//CLIENT
QActor client context ctxcargoserviceclients {
  	State s0 initial{
  		request cargoservice -m load_request : load($PID)
    }
}

//CARGOSERVICE
QActor cargoservice context ctxcargoservice {
  	State s0 initial {
    }
  	Transition t0 
  		whenRequest load_request -> handle_loadRequest
  		
  	State handle_loadRequest{
  	}
}

QActor cargorobot context ctxcargoservice {
  State s0 initial{
    }
}

QActor webgui_mock context ctxcargoservice {
  State s0 initial{
    }
}

//PRODUCTSERVICE
QActor productservice context ctxproductservice {
  State s0 initial{
    }
}

//BASICROBOT
QActor basicrobot context ctxbasicrobot {
  State s0 initial{
    }
}

//IODEVICES
QActor sonar context ctxiodevices {
  State s0 initial{
    }
}

QActor led context ctxiodevices {
  State s0 initial{
    }
}
