System cargoservice

//Richiesta di carico di un container
Request load_request : load(PID)
Reply   load_accepted : slot(SlotID) for load_request
Reply   load_refused  : reason(Motivation) for load_request

//Richiesta del prodotto
Request getProduct : product( PID )
Reply   getProductAnswer : product( JSonString ) for getProduct

//PRODUCTSERVICE
Context ctxproductservice ip [ host="localhost" port=8111]

//CARGOSERVICE
Context ctxcargoservice ip [ host="localhost" port=8110]

QActor cargoservice context ctxcargoservice
    withobj helper using "main.java.domain.CargoServiceHelper"{
      State s0 initial {
    }
      Transition t0 
          whenRequest load_request -> handle_loadRequest

      State handle_loadRequest{
          onMsg( load_request : load(PID) ) {
          [#
              val PID = payloadArg(0).toInt()
              CommUtils.outgreen("Ricevuta richiesta di carico per PID: $PID")
          #]
          request productservice -m getProduct : product($PID)
          }
      }
      Transition t1
      	whenReply getProductAnswer -> handle_productcontainer

    State handle_productcontainer {
    	onMsg( getProductAnswer : product(JSonString) ) {
	        [#
	            val jsonStr = payloadArg(0)
                val obj = org.json.JSONObject(jsonStr)
                val weight = obj.getInt("weight")
	
	            CommUtils.outgreen("Trovato prodotto con peso: $weight")
	
	            val res = helper.handleLoadRequest(weight)
	            if(res > 0){
	            	CommUtils.outgreen("Product container associato allo Slot n.$res")
	            	#]
	                replyTo load_request with load_accepted : slot(res)
	                [#
	            } else {
	            	if(res == -1) {
	            		CommUtils.outred("MAX_LOAD_EXCEEDED")
	            	 	#]
		                replyTo load_request with load_refused : reason("MAX_LOAD_EXCEEDED")
		                [#
	            	} else {
	            		if(res == -2) {
	            			CommUtils.outred("NO_FREE_SLOTS")
		            	 	#]
			                replyTo load_request with load_refused : reason("NO_FREE_SLOTS")
			                [#
		            	}
	            	}
	            }
	        #]
    	}
	}
}

QActor cargorobot context ctxcargoservice {
  State s0 initial{
    }
}

QActor webgui_mock context ctxcargoservice {
  State s0 initial{
    }
}

QActor productservice context ctxproductservice {
    State s0 initial {
    }
}